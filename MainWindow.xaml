<Window x:Class="NoJ_WAV_Master.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NoJ WAV Master v1.3.0" Height="815" Width="560"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI Variable Display, Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="PillRadio" TargetType="RadioButton">
            <Setter Property="Background" Value="#15171E"/>
            <Setter Property="Foreground" Value="#8E93A6"/>
            <Setter Property="BorderBrush" Value="#222530"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="9,6" Margin="0,0,5,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#383D4E"/>
                                <Setter Property="Foreground" Value="#E2E4EC"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E2233"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#6E7BF2"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModeCard" TargetType="RadioButton">
            <Setter Property="Background" Value="#13151B"/>
            <Setter Property="Foreground" Value="#8E93A6"/>
            <Setter Property="BorderBrush" Value="#22252F"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="10,10" Margin="3">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#383D4E"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A1D2B"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#6E7BF2"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8E93A6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1F222B"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TrackDeleteBtn" TargetType="Button">
            <Setter Property="Background" Value="#1E212D"/>
            <Setter Property="Foreground" Value="#A5ACC0"/>
            <Setter Property="BorderBrush" Value="#2C3142"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#361C26"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#F87171"/>
                                <Setter Property="Foreground" Value="#F87171"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CleanCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#D5D8E2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="Box" Width="16" Height="16" CornerRadius="4" Background="#161821" BorderBrush="#323646" BorderThickness="1" Margin="0,0,8,0">
                                <Path x:Name="Mark" Data="M3,8 L6.5,11.5 L13,4.5" Stroke="White" StrokeThickness="1.8" Visibility="Collapsed" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#6E7BF2"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#6E7BF2"/>
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Border Background="#0D0E12" BorderBrush="#232630" BorderThickness="1" CornerRadius="14" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown" Margin="18,0,12,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="26" Height="26" CornerRadius="7" Margin="0,0,10,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#6E7BF2" Offset="0"/>
                                <GradientStop Color="#9B6EF3" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Path Data="M4,13 L7,13 L9,6 L12,18 L15,9 L17,13 L20,13" Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="NoJ WAV Master" Foreground="#F3F4F6" FontSize="14.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Border Background="#1D202A" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="v1.3.0" Foreground="#7C85F2" FontSize="11" FontWeight="Medium"/>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ToggleButton x:Name="ToggleRackBtn" Checked="ToggleRack_Click" Unchecked="ToggleRack_Click" Cursor="Hand" Margin="0,0,10,0">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="Bd" Background="#171A24" BorderBrush="#2A2E3D" BorderThickness="1" CornerRadius="6" Padding="10,5">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M3,5 L13,5 M3,10 L13,10 M3,15 L13,15 M6,3 L6,7 M10,8 L10,12 M5,13 L5,17" Stroke="#9BA1B7" StrokeThickness="1.4" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="FX Rack" Foreground="#D5D8E2" FontSize="11.5" FontWeight="Medium" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#222638"/>
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#6E7BF2"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                    <Button Style="{StaticResource IconBtn}" Click="Minimize_Click" Margin="0,0,4,0">
                        <Path Data="M0,0 L10,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"/>
                    </Button>
                    <Button Style="{StaticResource IconBtn}" Click="Close_Click">
                        <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"/>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="18,4,18,10">
                        <TextBlock Text="PROCESSING ENGINE" Foreground="#5E6375" FontSize="10.5" FontWeight="Bold" Margin="4,0,0,5"/>
                        <UniformGrid Columns="4">
                            <RadioButton x:Name="ModeClean" GroupName="Mode" Style="{StaticResource ModeCard}" IsChecked="True" Checked="Setting_Changed">
                                <StackPanel>
                                    <TextBlock Text="Clean Master" FontSize="12" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                    <TextBlock Text="20-18k · -1dB" FontSize="10.5" Foreground="#686E82" Margin="0,3,0,0"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="ModeLoud" GroupName="Mode" Style="{StaticResource ModeCard}" Checked="Setting_Changed">
                                <StackPanel>
                                    <TextBlock Text="Loud (-14)" FontSize="12" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                    <TextBlock Text="Stream Std" FontSize="10.5" Foreground="#686E82" Margin="0,3,0,0"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="ModeManual" GroupName="Mode" Style="{StaticResource ModeCard}" Checked="ModeManual_Checked">
                                <StackPanel>
                                    <TextBlock Text="Manual FX" FontSize="12" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                    <TextBlock Text="Custom Rack" FontSize="10.5" Foreground="#7C85F2" Margin="0,3,0,0"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="ModeConvert" GroupName="Mode" Style="{StaticResource ModeCard}" Checked="Setting_Changed">
                                <StackPanel>
                                    <TextBlock Text="Convert Only" FontSize="12" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                    <TextBlock Text="Bypass FX" FontSize="10.5" Foreground="#686E82" Margin="0,3,0,0"/>
                                </StackPanel>
                            </RadioButton>
                        </UniformGrid>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="21,0,18,8">
                        <TextBlock Text="TARGET FORMAT" Foreground="#5E6375" FontSize="10.5" FontWeight="Bold" Margin="0,0,0,6"/>
                        <WrapPanel>
                            <RadioButton x:Name="FmtWav24" Content="WAV 24-bit" GroupName="Fmt" Style="{StaticResource PillRadio}" IsChecked="True" Checked="Setting_Changed" FontSize="11.5" FontWeight="Medium"/>
                            <RadioButton x:Name="FmtWav16" Content="WAV 16-bit" GroupName="Fmt" Style="{StaticResource PillRadio}" Checked="Setting_Changed" FontSize="11.5" FontWeight="Medium"/>
                            <RadioButton x:Name="FmtFlac16" Content="FLAC 16-bit" GroupName="Fmt" Style="{StaticResource PillRadio}" Checked="Setting_Changed" FontSize="11.5" FontWeight="Medium"/>
                            <RadioButton x:Name="FmtFlac24" Content="FLAC 24-bit" GroupName="Fmt" Style="{StaticResource PillRadio}" Checked="Setting_Changed" FontSize="11.5" FontWeight="Medium"/>
                            <RadioButton x:Name="FmtMp3" Content="MP3 320k" GroupName="Fmt" Style="{StaticResource PillRadio}" Checked="Setting_Changed" FontSize="11.5" FontWeight="Medium"/>
                            <RadioButton x:Name="FmtAiff" Content="AIFF" GroupName="Fmt" Style="{StaticResource PillRadio}" Checked="Setting_Changed" FontSize="11.5" FontWeight="Medium"/>
                            <RadioButton x:Name="FmtAac" Content="AAC" GroupName="Fmt" Style="{StaticResource PillRadio}" Checked="Setting_Changed" FontSize="11.5" FontWeight="Medium"/>
                        </WrapPanel>
                        <Border Background="#141720" BorderBrush="#222634" BorderThickness="1" CornerRadius="8" Padding="11,6" Margin="0,2,3,0">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox x:Name="ChkTrimSilence" Content="Auto Trim Silence (앞뒤 무음 제거)" Style="{StaticResource CleanCheck}" Click="TrimFade_Click" FontSize="11.5" FontWeight="Medium" Margin="0,0,18,0"/>
                                    <CheckBox x:Name="ChkFadeOut" Style="{StaticResource CleanCheck}" Click="TrimFade_Click" FontSize="11.5" FontWeight="Medium">
                                        <TextBlock Text="{Binding ElementName=SldFadeOut, Path=Value, StringFormat={}Smooth Fade Out ({0:0.0}s 페이드 아웃)}" Foreground="#D5D8E2"/>
                                    </CheckBox>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <Border x:Name="DropZone" Grid.Row="2" Margin="21,0,21,10" Background="#12141A" BorderBrush="#252834" BorderThickness="1.5" CornerRadius="12"
                            AllowDrop="True" Drop="DropZone_Drop" DragEnter="DropZone_DragEnter" DragLeave="DropZone_DragLeave" MouseLeftButtonDown="DropZone_Click" Cursor="Hand">
                        <Grid>
                            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                                <Border Width="44" Height="44" CornerRadius="22" Background="#191C26" Margin="0,0,0,10">
                                    <Path Data="M12,16 L12,6 M12,6 L8,10 M12,6 L16,10 M5,18 L19,18" Stroke="#7C85F2" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-2,-2,0,0"/>
                                </Border>
                                <TextBlock Text="Drop audio files here or click to add tracks" Foreground="#D5D8E2" FontSize="13" FontWeight="Medium" HorizontalAlignment="Center"/>
                                <TextBlock Text="Adjust engine &amp; FX settings, then press Start Mastering below" Foreground="#606578" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>

                            <ListBox x:Name="FileList" Background="Transparent" BorderThickness="0" Padding="10" Visibility="Collapsed" SelectionChanged="FileList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="ItemBd" Background="#171A23" BorderBrush="#232733" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,0,6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Path Data="M8,5 L18,12 L8,19 Z" Fill="#7C85F2" Margin="0,0,10,0" VerticalAlignment="Center">
                                                                    <Path.LayoutTransform>
                                                                        <ScaleTransform ScaleX="0.65" ScaleY="0.65"/>
                                                                    </Path.LayoutTransform>
                                                                </Path>
                                                                <TextBlock Text="{Binding FileName}" Foreground="#E2E4EC" FontSize="12.5" TextTrimming="CharacterEllipsis" MaxWidth="260" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                            <Border Grid.Column="1" Background="#202431" CornerRadius="5" Padding="8,3" Margin="0,0,6,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}" FontSize="11" FontWeight="SemiBold"/>
                                                            </Border>
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Button Click="OpenTrackFolder_Click" Tag="{Binding}" ToolTip="파일 위치 열기 (Open Folder)" Width="24" Height="24" Style="{StaticResource IconBtn}" Margin="0,0,4,0">
                                                                    <Path Data="M1,3 L5,3 L6.5,5 L13,5 L13,12 L1,12 Z" Stroke="#8E93A6" StrokeThickness="1.3" Fill="Transparent"/>
                                                                </Button>
                                                                <Button Click="RemoveTrack_Click" Tag="{Binding}" ToolTip="트랙 개별 삭제 (Del)" Style="{StaticResource TrackDeleteBtn}">
                                                                    <TextBlock Text="✕" FontSize="11" FontWeight="Bold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="ItemBd" Property="BorderBrush" Value="#6E7BF2"/>
                                                            <Setter TargetName="ItemBd" Property="Background" Value="#1E2231"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Grid>
                    </Border>

                    <Border Grid.Row="3" Margin="21,0,21,8" Background="#13151D" BorderBrush="#232734" BorderThickness="1" CornerRadius="11" Padding="14,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="64"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="PlayPauseBtn" Click="PlayPause_Click" Width="30" Height="30" Cursor="Hand" Background="#6E7BF2" BorderThickness="0" Tag="M1,0 L10,5.5 L1,11 Z">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="15">
                                                    <Path x:Name="PlayIcon" Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Fill="White" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="NowPlayingText" Text="Select a track to inspect &amp; preview" Foreground="#D5D8E2" FontSize="12" FontWeight="SemiBold" MaxWidth="220" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="TimeText" Text="00:00 / 00:00" Foreground="#686E82" FontSize="10.5"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <RadioButton x:Name="BtnBefore" Content="BEFORE (Raw)" GroupName="AB" Checked="AB_Changed" Cursor="Hand" Margin="0,0,4,0" ToolTip="Switch to Raw Audio (Shortcut: Tab or B)">
                                        <RadioButton.Template>
                                            <ControlTemplate TargetType="RadioButton">
                                                <Border x:Name="B" Background="#1A1D27" BorderBrush="#282C3B" BorderThickness="1" CornerRadius="6" Padding="9,5">
                                                    <TextBlock x:Name="T" Text="{TemplateBinding Content}" Foreground="#8E93A6" FontSize="11" FontWeight="SemiBold"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="B" Property="Background" Value="#2C222E"/>
                                                        <Setter TargetName="B" Property="BorderBrush" Value="#F472B6"/>
                                                        <Setter TargetName="T" Property="Foreground" Value="#F472B6"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </RadioButton.Template>
                                    </RadioButton>
                                    <RadioButton x:Name="BtnAfter" Content="AFTER (Live FX)" GroupName="AB" IsChecked="True" Checked="AB_Changed" Cursor="Hand" ToolTip="Switch to Live FX Preview (Shortcut: Tab or B)">
                                        <RadioButton.Template>
                                            <ControlTemplate TargetType="RadioButton">
                                                <Border x:Name="B" Background="#1A1D27" BorderBrush="#282C3B" BorderThickness="1" CornerRadius="6" Padding="9,5">
                                                    <TextBlock x:Name="T" Text="{TemplateBinding Content}" Foreground="#8E93A6" FontSize="11" FontWeight="SemiBold"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="B" Property="Background" Value="#1B2A28"/>
                                                        <Setter TargetName="B" Property="BorderBrush" Value="#4ADE80"/>
                                                        <Setter TargetName="T" Property="Foreground" Value="#4ADE80"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </RadioButton.Template>
                                    </RadioButton>
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="1" Background="#0C0E14" CornerRadius="7" BorderBrush="#1C1F2B" BorderThickness="1" ClipToBounds="True" MouseLeftButtonDown="Waveform_MouseDown" Cursor="Hand">
                                <Grid>
                                    <Canvas x:Name="WaveformCanvas" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" SizeChanged="WaveformCanvas_SizeChanged"/>
                                    <Rectangle x:Name="Playhead" Width="2" Fill="#FFFFFF" HorizontalAlignment="Left" Visibility="Collapsed"/>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="2" Margin="2,6,2,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="8" Height="8" CornerRadius="2" Background="#3B425E" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Base" Foreground="#686E82" FontSize="10" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <Border Width="8" Height="8" CornerRadius="2" Background="#4ADE80" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="+Boosted (After)" Foreground="#86EFAC" FontSize="10" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <Border Width="8" Height="8" CornerRadius="2" Background="#F472B6" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="-Cut / Limited (Before)" Foreground="#F9A8D4" FontSize="10" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="DiffStatsText" Text="Overlay Diff Ready" Foreground="#7C85F2" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <UniformGrid Grid.Row="3" Columns="4" Margin="0,8,0,0">
                                <Border Background="#161922" BorderBrush="#222634" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,0,4,0">
                                    <StackPanel>
                                        <TextBlock Text="LOUDNESS" Foreground="#5E6375" FontSize="9.5" FontWeight="Bold"/>
                                        <TextBlock x:Name="TxtLufs" Text="-- LUFS" Foreground="#D5D8E2" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#161922" BorderBrush="#222634" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="2,0,2,0">
                                    <StackPanel>
                                        <TextBlock Text="TRUE PEAK" Foreground="#5E6375" FontSize="9.5" FontWeight="Bold"/>
                                        <TextBlock x:Name="TxtPeak" Text="-- dBTP" Foreground="#D5D8E2" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#161922" BorderBrush="#222634" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="2,0,2,0">
                                    <StackPanel>
                                        <TextBlock Text="DYNAMICS / SR" Foreground="#5E6375" FontSize="9.5" FontWeight="Bold"/>
                                        <TextBlock x:Name="TxtLra" Text="-- LU" Foreground="#D5D8E2" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="GradeBadge" Background="#161922" BorderBrush="#222634" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="4,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="QC VERDICT" Foreground="#5E6375" FontSize="9.5" FontWeight="Bold"/>
                                        <TextBlock x:Name="TxtGrade" Text="STANDBY" Foreground="#8E93A6" FontSize="12" FontWeight="Bold" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="4" Margin="21,0,21,14">
                        <Grid Margin="2,0,2,8">
                            <TextBlock x:Name="StatusText" Text="Ready · EBU R128 Audio QC Inspector active" Foreground="#686E82" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="360" HorizontalAlignment="Left"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="AddFilesBtn" Content="+ Add Files" Click="AddFiles_Click" Visibility="Collapsed" Margin="0,0,6,0"
                                        Background="#1A1D29" Foreground="#9EA6F6" BorderBrush="#2D3348" BorderThickness="1" Padding="10,4" Cursor="Hand" FontSize="11">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button x:Name="ClearBtn" Content="Clear" Click="Clear_Click" Visibility="Collapsed"
                                        Background="#1C1F2B" Foreground="#C5C9D6" BorderBrush="#2B3040" BorderThickness="1" Padding="10,4" Cursor="Hand" FontSize="11">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Button x:Name="StartBtn" Content="DROP OR ADD TRACKS TO START" Click="StartProcess_Click" IsEnabled="False" Height="44" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="BtnBd" CornerRadius="10" BorderThickness="1" BorderBrush="#8B95F6">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#6E7BF2" Offset="0"/>
                                                <GradientStop Color="#8B5CF6" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path x:Name="BtnIcon" Data="M4,2 L14,8 L4,14 Z" Fill="#FFFFFF" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="BtnTxt" Text="{TemplateBinding Content}" Foreground="#FFFFFF" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="BtnBd" Property="BorderBrush" Value="#C4B5FD"/>
                                            <Setter TargetName="BtnBd" Property="Opacity" Value="0.95"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="BtnBd" Property="Opacity" Value="0.85"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="BtnBd" Property="Background" Value="#161822"/>
                                            <Setter TargetName="BtnBd" Property="BorderBrush" Value="#232736"/>
                                            <Setter TargetName="BtnIcon" Property="Fill" Value="#484E63"/>
                                            <Setter TargetName="BtnTxt" Property="Foreground" Value="#484E63"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>

                <Border x:Name="FxRackPanel" Grid.Column="1" Width="320" Visibility="Collapsed" BorderBrush="#222530" BorderThickness="1,0,0,0" Background="#101218" Padding="18,8,18,16">
                    <ScrollViewer VerticalScrollBarVisibility="Hidden">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="MANUAL FX STUDIO RACK" Foreground="#7C85F2" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                <Button Content="Reset" Click="ResetFx_Click" HorizontalAlignment="Right" Background="Transparent" Foreground="#686E82" BorderThickness="0" Cursor="Hand" FontSize="11"/>
                            </Grid>

                            <Border Background="#161926" BorderBrush="#353D63" BorderThickness="1" CornerRadius="9" Padding="12,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <Grid>
                                        <CheckBox x:Name="ChkAtmos" Content="Dolby Atmos 3D Spatializer" Style="{StaticResource CleanCheck}" Click="FxControl_Click" FontWeight="SemiBold" FontSize="12"/>
                                        <Border Background="#232946" BorderBrush="#4F5BD5" BorderThickness="1" CornerRadius="4" Padding="5,1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="ATMOS 3D" Foreground="#9EA6F6" FontSize="9" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>
                                    <Grid Margin="0,8,0,0">
                                        <TextBlock Text="Spatial 3D Depth (Elevation)" Foreground="#8E93A6" FontSize="11"/>
                                        <TextBlock Text="{Binding ElementName=SldAtmosDepth, Path=Value, StringFormat={}{0:0}%}" Foreground="#D5D8E2" FontSize="11" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Slider x:Name="SldAtmosDepth" Minimum="0" Maximum="100" Value="50" ValueChanged="FxSlider_ValueChanged" Margin="0,4,0,6"/>
                                    <Grid>
                                        <TextBlock Text="Surround Expansion" Foreground="#8E93A6" FontSize="11"/>
                                        <TextBlock Text="{Binding ElementName=SldAtmosSurround, Path=Value, StringFormat={}{0:0}%}" Foreground="#D5D8E2" FontSize="11" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Slider x:Name="SldAtmosSurround" Minimum="100" Maximum="220" Value="155" ValueChanged="FxSlider_ValueChanged" Margin="0,4,0,6"/>
                                    <Grid>
                                        <TextBlock Text="LFE Sub-Bass Boost (60Hz)" Foreground="#8E93A6" FontSize="11"/>
                                        <TextBlock Text="{Binding ElementName=SldAtmosLfe, Path=Value, StringFormat={}+{0:0.0} dB}" Foreground="#D5D8E2" FontSize="11" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Slider x:Name="SldAtmosLfe" Minimum="0" Maximum="9.0" Value="3.5" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="FxSlider_ValueChanged" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#151821" BorderBrush="#222634" BorderThickness="1" CornerRadius="9" Padding="12,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <CheckBox x:Name="ChkEqCut" Content="Edge EQ Filter (Watermark Cut)" Style="{StaticResource CleanCheck}" IsChecked="True" Click="FxControl_Click" FontWeight="SemiBold" FontSize="12"/>
                                    <Grid Margin="0,8,0,0">
                                        <TextBlock Text="Low Cut (Hz)" Foreground="#8E93A6" FontSize="11"/>
                                        <TextBlock Text="{Binding ElementName=SldLowCut, Path=Value, StringFormat={}{0:0} Hz}" Foreground="#D5D8E2" FontSize="11" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Slider x:Name="SldLowCut" Minimum="10" Maximum="200" Value="20" ValueChanged="FxSlider_ValueChanged" Margin="0,4,0,6"/>
                                    <Grid>
                                        <TextBlock Text="High Cut (Hz)" Foreground="#8E93A6" FontSize="11"/>
                                        <TextBlock Text="{Binding ElementName=SldHighCut, Path=Value, StringFormat={}{0:0} Hz}" Foreground="#D5D8E2" FontSize="11" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Slider x:Name="SldHighCut" Minimum="10000" Maximum="22000" Value="18000" TickFrequency="500" IsSnapToTickEnabled="True" ValueChanged="FxSlider_ValueChanged" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#151821" BorderBrush="#222634" BorderThickness="1" CornerRadius="9" Padding="12,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <CheckBox x:Name="ChkLimiter" Content="Brickwall Ceiling Limiter" Style="{StaticResource CleanCheck}" IsChecked="True" Click="FxControl_Click" FontWeight="SemiBold" FontSize="12"/>
                                    <Grid Margin="0,8,0,0">
                                        <TextBlock Text="True Peak Ceiling" Foreground="#8E93A6" FontSize="11"/>
                                        <TextBlock Text="{Binding ElementName=SldLimit, Path=Value, StringFormat={}{0:0.0} dB}" Foreground="#D5D8E2" FontSize="11" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Slider x:Name="SldLimit" Minimum="-3.0" Maximum="-0.1" Value="-1.0" TickFrequency="0.1" IsSnapToTickEnabled="True" ValueChanged="FxSlider_ValueChanged" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#151821" BorderBrush="#222634" BorderThickness="1" CornerRadius="9" Padding="12,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <CheckBox x:Name="ChkLoudness" Content="Loudness Normalizer (LUFS)" Style="{StaticResource CleanCheck}" Click="FxControl_Click" FontWeight="SemiBold" FontSize="12"/>
                                    <Grid Margin="0,8,0,0">
                                        <TextBlock Text="Target Integrated LUFS" Foreground="#8E93A6" FontSize="11"/>
                                        <TextBlock Text="{Binding ElementName=SldLufs, Path=Value, StringFormat={}{0:0} LUFS}" Foreground="#D5D8E2" FontSize="11" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Slider x:Name="SldLufs" Minimum="-20" Maximum="-7" Value="-14" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="FxSlider_ValueChanged" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#151821" BorderBrush="#222634" BorderThickness="1" CornerRadius="9" Padding="12,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <CheckBox x:Name="ChkWarmth" Content="Analog Tube Warmth (Saturation)" Style="{StaticResource CleanCheck}" Click="FxControl_Click" FontWeight="SemiBold" FontSize="12"/>
                                    <Grid Margin="0,8,0,0">
                                        <TextBlock Text="Harmonic Drive" Foreground="#8E93A6" FontSize="11"/>
                                        <TextBlock Text="{Binding ElementName=SldWarmth, Path=Value, StringFormat={}{0:0}%}" Foreground="#D5D8E2" FontSize="11" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Slider x:Name="SldWarmth" Minimum="0" Maximum="100" Value="25" ValueChanged="FxSlider_ValueChanged" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#151821" BorderBrush="#222634" BorderThickness="1" CornerRadius="9" Padding="12,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <CheckBox x:Name="ChkReverb" Content="Space Reverb &amp; Room Echo" Style="{StaticResource CleanCheck}" Click="FxControl_Click" FontWeight="SemiBold" FontSize="12"/>
                                    <Grid Margin="0,8,0,0">
                                        <TextBlock Text="Room Delay (ms)" Foreground="#8E93A6" FontSize="11"/>
                                        <TextBlock Text="{Binding ElementName=SldDelay, Path=Value, StringFormat={}{0:0} ms}" Foreground="#D5D8E2" FontSize="11" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Slider x:Name="SldDelay" Minimum="20" Maximum="300" Value="65" ValueChanged="FxSlider_ValueChanged" Margin="0,4,0,6"/>
                                    <Grid>
                                        <TextBlock Text="Wet Decay Mix" Foreground="#8E93A6" FontSize="11"/>
                                        <TextBlock Text="{Binding ElementName=SldDecay, Path=Value, StringFormat={}{0:0}%}" Foreground="#D5D8E2" FontSize="11" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Slider x:Name="SldDecay" Minimum="5" Maximum="70" Value="22" ValueChanged="FxSlider_ValueChanged" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#151821" BorderBrush="#222634" BorderThickness="1" CornerRadius="9" Padding="12,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <CheckBox x:Name="ChkStereo" Content="Stereo Image Widener" Style="{StaticResource CleanCheck}" Click="FxControl_Click" FontWeight="SemiBold" FontSize="12"/>
                                    <Grid Margin="0,8,0,0">
                                        <TextBlock Text="Stereo Width" Foreground="#8E93A6" FontSize="11"/>
                                        <TextBlock Text="{Binding ElementName=SldStereo, Path=Value, StringFormat={}{0:0}%}" Foreground="#D5D8E2" FontSize="11" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Slider x:Name="SldStereo" Minimum="100" Maximum="200" Value="135" ValueChanged="FxSlider_ValueChanged" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#151821" BorderBrush="#222634" BorderThickness="1" CornerRadius="9" Padding="12,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <CheckBox x:Name="ChkPitch" Content="Pitch &amp; Speed Shift" Style="{StaticResource CleanCheck}" Click="FxControl_Click" FontWeight="SemiBold" FontSize="12"/>
                                    <Grid Margin="0,8,0,0">
                                        <TextBlock Text="Semitones" Foreground="#8E93A6" FontSize="11"/>
                                        <TextBlock Text="{Binding ElementName=SldPitch, Path=Value, StringFormat={}{0:+0;-0;0} st}" Foreground="#D5D8E2" FontSize="11" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Slider x:Name="SldPitch" Minimum="-6" Maximum="6" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="FxSlider_ValueChanged" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#151821" BorderBrush="#222634" BorderThickness="1" CornerRadius="9" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="Silence Trim &amp; Fade Out Detail" Foreground="#D5D8E2" FontWeight="SemiBold" FontSize="12"/>
                                    <Grid Margin="0,8,0,0">
                                        <TextBlock Text="Silence Threshold (무음 기준)" Foreground="#8E93A6" FontSize="11"/>
                                        <TextBlock Text="{Binding ElementName=SldTrimDb, Path=Value, StringFormat={}{0:0} dB}" Foreground="#D5D8E2" FontSize="11" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Slider x:Name="SldTrimDb" Minimum="-65" Maximum="-30" Value="-50" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="TrimFadeSlider_ValueChanged" Margin="0,4,0,6"/>
                                    <Grid>
                                        <TextBlock Text="Fade Out Duration (길이)" Foreground="#8E93A6" FontSize="11"/>
                                        <TextBlock Text="{Binding ElementName=SldFadeOut, Path=Value, StringFormat={}{0:0.0} s}" Foreground="#D5D8E2" FontSize="11" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Slider x:Name="SldFadeOut" Minimum="0.5" Maximum="5.0" Value="2.0" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="TrimFadeSlider_ValueChanged" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
